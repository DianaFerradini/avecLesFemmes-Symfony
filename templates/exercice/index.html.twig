{% extends 'base.html.twig' %}

{% block title %}Exercice{% endblock %}

{% block stylesheets %}
    {{ parent() }}
        <link rel="stylesheet" href="{{ asset('css/pagination.css') }}">
{% endblock %}

{% block body %}
    <main class="contenu">
        <a class="retour" href="#liste">Tous les groupements</a>
 
        <div class="tete-page">
            <div>
                <h1>{{ groupementExerciceListDto.nom }}</h1>
                <dl class="coordonnees">
                    <div>
                        <dt>Téléphone</dt>
                        <dd>{{ groupementExerciceListDto.tel }}</dd>
                    </div>
                    <div>
                        <dt>Adresse</dt>
                        <dd>{{ groupementExerciceListDto.adresse }}</dd>
                    </div>
                </dl>
            </div>
            <div class="groupe-boutons">
                <a class="bouton bouton--secondaire" href="#">Modifier</a>
                <button class="bouton" type="button" disabled>Ouvrir un exercice</button>
            </div>
        </div>
 
        <section class="panneau" aria-labelledby="titre-exercice">
            <div class="entete-panneau">
                <div>
                    {% set exercice = groupementExerciceListDto.exercices[0] %}
                    <h2 id="titre-exercice">Exercice en cours</h2>
                    <p class="sous-titre"></p>
                </div>
                <button class="bouton bouton--secondaire" type="button">Clôturer l’exercice</button>
            </div>
 
            <ol class="frise">
                <li class="etape etape--passee">
                    <span class="etape__nom">Début</span>
                    <span class="etape__date">{{ exercice.dateDebut }}</span>
                </li>
                <li class="etape etape--prochaine">
                    <span class="etape__nom">Date limite des prêts</span>
                    <span class="etape__date">{{ exercice.limitePretsAt }}</span>
                    <span class="etape__note">Encore {{ exercice.nbrJoursRestant }} jours pour prêter</span>
                </li>
                <li class="etape">
                    <span class="etape__nom">Fin</span>
                    <span class="etape__date">{{ exercice.dateFin }}</span>
                </li>
                <li class="etape">
                    <span class="etape__nom">Rétribution</span>
                    <span class="etape__date">{{ exercice.retributionAt }}</span>
                </li>
            </ol>
        </section>
 
        <section class="panneau" aria-labelledby="titre-historique">
            <div class="entete-panneau">
                <h2 id="titre-historique">Historique des exercices</h2>
            </div>
            <div class="defilement">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Période</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Rétribution</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if groupementExerciceListDto.exercices|length >= 1 %}
                            {% for exercice in groupementExerciceListDto.exercices|slice(1) %}
                                <tr>
                                    <td>{{ exercice.dateDebut }} – {{ exercice.dateFin }}</td>
                                    <td><span class="statut statut--{{ exercice.statut|lower }}">{{ exercice.statut }}</span></td>
                                    <td>{{ exercice.retributionAt }}</td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="3">Aucun exercice historique</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
                <nav class="pagination" aria-label="Pagination de l’historique">
                    {% set route = app.request.attributes.get('_route') %}
                    {% set params = app.request.attributes.get('_route_params') %}
                    {% if pageEnCours > 1 %}
                        <a class="pagination__lien" rel="prev" href="{{ path(route, params|merge({'page': pageEnCours - 1})) }}">Précédent</a>
                    {% endif %}

                    {# pagination__lien--actif #}
                  
                    {% for page in 1..nbrPages %}
                
                        <a class="pagination__lien {{ page == pageEnCours ? 'pagination__lien--actif' : '' }}" href="{{ path(route, params|merge({'page': page})) }}">{{ page }}</a>

                    {% endfor %}
                    {% if pageEnCours < nbrPages %}
                        <a class="pagination__lien" rel="next" href="{{ path(route, params|merge({'page': pageEnCours + 1})) }}">Suivant</a>
                    {% endif %}
                </nav>
            </div>
        </section>
    </main>
 
{% endblock %}
